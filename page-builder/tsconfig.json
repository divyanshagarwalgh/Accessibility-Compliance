{
  "compilerOptions": {
    "outDir": "public",
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "node",
    "strict": true,
    "lib": ["es6", "dom"],
    "typeRoots": ["./node_modules/@types", "./node_modules/@webflow"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
