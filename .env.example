# Copy to .env.local (gitignored) for local development.
# In production these are set in Webflow Cloud → environment → environment variables.
# NEVER commit real values. See guardrail 4.

# --- Scan service (Cloudflare Browser Rendering worker, separate CF account) ---
SCAN_SERVICE_URL=
SCAN_CALLBACK_SECRET=

# --- Brevo (use a NEW list for accessibility leads, not the existing list 3) ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Anthropic (alt-text drafting, Phase 5) ---
ANTHROPIC_API_KEY=

# --- Webflow CLI (DevLink) ---
# Written automatically by `webflow devlink import` on first auth. Do not commit.
WEBFLOW_SITE_API_TOKEN=
