{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webyansh-a11y",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a11y-db",
      "database_id": "local-placeholder-webflow-cloud-generates-this",
      "migrations_dir": "./migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local-placeholder-webflow-cloud-generates-this"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "a11y-artifacts"
    }
  ]
}
